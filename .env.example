# ===== 服务 =====
HOST=127.0.0.1
PORT=8000
DEBUG=true
LOG_LEVEL=INFO

# ===== 数据库 =====
# 默认 MySQL 8；连不上时自动降级到本地 SQLite（data/code_mentor.db）
DATABASE_URL=mysql+aiomysql://root:root@127.0.0.1:3306/code_mentor?charset=utf8mb4
DB_FALLBACK_SQLITE=true
DB_ECHO=false

# ===== 向量库 =====
# local: Qdrant 官方 embedded 模式（落盘 data/qdrant，无需 Docker）
# remote: 连接 qdrant/qdrant 服务端
QDRANT_MODE=local
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=

# auto = 离线哈希向量（无需联网）；api = 走在线 Embedding；local = sentence-transformers
EMBEDDING_PROVIDER=auto
EMBEDDING_DIM=512
EMBEDDING_MODEL=text-embedding-v3

# ===== Agent =====
AGENT_MAX_ITERATIONS=6
AGENT_TOP_K=4
PYTHON_SANDBOX_TIMEOUT=12
SHORT_TERM_WINDOW=12
SUMMARY_TRIGGER=10

# ===== 速度（时延相关，全部可在 UI「运行参数」里改，改完立即生效）=====
# 工具轮回上限：1=最快（工具并行执行后直接作答），2=允许"检索后再改代码"
AGENT_TOOL_ROUNDS=1
# 单轮总预算（秒）：超时不再发起新工具，用已有证据作答
AGENT_BUDGET_S=90
# 快速通道：寒暄/极短的追问跳过规划与决策
AGENT_FAST_LANE=true
# 规划器输出上限（规划 JSON 很短）
PLANNER_MAX_TOKENS=500
# 关闭思维链（仅通义 Qwen3 系列生效；思考型模型单跳可能 20s+）
LLM_DISABLE_THINKING=false

# ===== 屏幕演示 =====
SCREEN_INTERVAL_MS=5000
SCREEN_MAX_STEPS=40
# 抓帧采样间隔（毫秒）：便宜，只决定多久看一眼界面
SCREEN_CAPTURE_MS=200
# 画面完全没变时跳过模型调用
SCREEN_SKIP_UNCHANGED=true
SCREEN_DRY_RUN=false
SCREEN_MONITOR=1
# 视觉决策输出上限（动作 JSON 很短，限制它能明显缩短生成时间）
SCREEN_MAX_TOKENS=320
# 文本输入方式：clipboard=始终剪贴板粘贴（不受输入法影响）
SCREEN_TYPE_MODE=clipboard
# 演示期间临时把前台程序切英文输入法，结束还原
SCREEN_IME_GUARD=true